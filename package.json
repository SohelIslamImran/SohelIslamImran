{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && tsc --noEmit",
		"dev": "bun run db:migrate && vite dev",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"typecheck": "wrangler types && tsc --noEmit",
		"check": "oxlint src vite.config.ts vitest.config.ts && oxfmt --check src vite.config.ts vitest.config.ts '!src/routeTree.gen.ts'",
		"test": "vitest run --config vitest.config.ts",
		"deploy": "bun run build && wrangler deploy",
		"deploy:ci": "bun scripts/deploy-ci.ts",
		"preview": "vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.7",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-orm": "0.45.4",
		"jose": "6.2.18",
		"motion": "14.14.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.70.1",
		"@cloudflare/workers-types": "5.20261121.1",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/router-plugin": "1.169.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"miniflare": "5.20260911.0-alpha",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"wrangler": "4.166.0"
	},
	"packageManager": "bun@1.4.0"
}
