{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && tsc --noEmit",
		"dev": "bun run db:migrate && vite dev",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"typecheck": "wrangler types && tsc --noEmit",
		"check": "oxlint src vite.config.ts vitest.config.ts && oxfmt --check src vite.config.ts vitest.config.ts '!src/routeTree.gen.ts'",
		"test": "vitest run --config vitest.config.ts",
		"deploy": "bun run build && wrangler deploy",
		"preview": "vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tanstack/react-router": "1.170.35",
		"@tanstack/react-start": "1.168.52",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.2.6",
		"drizzle-orm": "0.45.2",
		"jose": "6.2.12",
		"motion": "13.2.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tw-animate-css": "^1.4.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.54.8",
		"@cloudflare/workers-types": "5.20260911.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-plugin": "1.168.37",
		"@types/node": "26.5.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"miniflare": "5.20260911.0-alpha",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"shadcn": "^4.21.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.0",
		"wrangler": "4.131.1"
	},
	"packageManager": "bun@1.4.0"
}
